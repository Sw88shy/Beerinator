{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "cmake: configure",
      "type": "shell",
      "command": "cmake",
      "args": [
        "-S",
        ".",
        "-B",
        "build"
      ],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "cmake: build all",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "build",
        "--config",
        "${input:buildType}"
      ],
      "dependsOn": [
        "cmake: configure"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "buildType",
      "type": "pickString",
      "description": "CMake build configuration",
      "options": [
        "Debug",
        "Release"
      ],
      "default": "Debug"
    }
  ]
}
